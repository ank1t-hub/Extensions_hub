# Application
APP_NAME=ExtensionHub API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database — Phase 1.2 (Alembic). Port must match MYSQL_PORT in root .env
DATABASE_URL=mysql+pymysql://extensionhub:extensionhub@localhost:3306/extensionhub

# Security (change in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploads
UPLOAD_DIR=uploads/extensions
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.zip,.vsix,.crx
